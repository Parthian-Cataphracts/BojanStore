<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <config>
    <!-- The dev network here is slow enough that NuGet's default request
         timeout drops mid-download on larger packages (Roslyn analyzers in
         particular). Five minutes gives a multi-megabyte package room on a
         connection well under 100 KB/s. -->
    <add key="http_timeout" value="300" />
  </config>
</configuration>
