<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bojan.Application\Bojan.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The design's own catalogue, lifted from the frontend fixtures. Embedded
      rather than copied to disk so the seeder cannot be run against a file
      that drifted from the build it shipped with.
    -->
    <EmbeddedResource Include="Persistence\Seed\catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>

</Project>
