<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Bojan.Application\Bojan.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      So the Web Push wire format can be pinned against the RFC's own worked
      example. It is internal because nothing outside this assembly has any
      business calling it, and a construction of that kind is only known to be
      right by testing it against published vectors.
    -->
    <InternalsVisibleTo Include="Bojan.Api.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The design's own catalogue, lifted from the frontend fixtures. Embedded
      rather than copied to disk so the seeder cannot be run against a file
      that drifted from the build it shipped with.
    -->
    <EmbeddedResource Include="Persistence\Seed\catalogue.json" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The Persian font the PDF reports embed. Shipped in the assembly rather
      than read from the host: a container image has no Persian font installed,
      and resolving one from the machine would make the file depend on which
      host built it. See PdfWriter.
    -->
    <EmbeddedResource Include="Assets\Vazirmatn-Regular.ttf" />
    <EmbeddedResource Include="Assets\Vazirmatn-Bold.ttf" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <!-- The pooled handler behind the ZarinPal client: one socket pool for the
         whole process rather than a new connection per payment. -->
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="MailKit" />
    <PackageReference Include="Microsoft.AspNetCore.DataProtection" />
    <PackageReference Include="HtmlSanitizer" />
    <PackageReference Include="QuestPDF" />
  </ItemGroup>

</Project>
