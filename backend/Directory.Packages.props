<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <!--
    One version per package for the whole solution. Bojan.Api and
    Bojan.Infrastructure both reference EF Core; without this file they can
    silently drift to different patch versions the way this solution's first
    migration attempt just did — a preview provider against a GA core threw an
    unhelpful MissingMethodException at `dotnet ef migrations add` instead of
    a version-mismatch warning at restore time. Every version below was
    checked against nuget.org before being pinned here.
  -->
  <ItemGroup>
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <!--
      Pinned above what EFCore.Sqlite pulls in transitively. Its own choice is
      SQLitePCLRaw 2.1.11, whose native binary carries GHSA-2m69-gcr7-jv3q; the
      3.x line is the patched one. Test-only either way — production runs on
      Npgsql — but a known-vulnerable package in the tree is a thing somebody
      has to keep re-deciding about.
    -->
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.core" Version="3.0.5" />
    <PackageVersion Include="SQLitePCLRaw.provider.e_sqlite3" Version="3.0.5" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.10" />

    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />

    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageVersion Include="System.IdentityModel.Tokens.Jwt" Version="8.19.2" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />

    <!--
      The support mailbox. MailKit speaks IMAP and SMTP; HtmlSanitizer
      allow-lists the HTML of an inbound message before an operator's browser
      ever sees it.
    -->
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <!--
      Encrypts the mailbox password at rest. Infrastructure is a class library
      with no ASP.NET framework reference, so the type comes from a package
      rather than the shared framework the API gets it from.
    -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection" Version="10.0.10" />
    <PackageVersion Include="HtmlSanitizer" Version="9.1.973" />

    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
  </ItemGroup>

</Project>
