#!/usr/bin/env bash
#
# Bojan Store — system management.
#
# Installed to /usr/local/bin/b-ui by deploy/install.sh, which rewrites the
# BOJAN_ROOT line below to wherever it put the source.
#
# Run it bare for the menu, or give it a subcommand when you already know what
# you want — the menu is for an operator sitting on the box, the subcommands
# are for a script or an ssh one-liner:
#
#   b-ui              interactive menu
#   b-ui status       what is running, and where
#   b-ui logs [svc]   follow the logs
#   b-ui update       pull, rebuild, roll back automatically if unhealthy
#   b-ui backup       dump the database to ./backups
#   b-ui password     change the operator password
#   b-ui domain       change the public address and re-issue the certificate
#   b-ui ssl          renew the certificate now
#   b-ui restart      restart the services
#   b-ui start        start the stack
#   b-ui stop         stop everything, keeping the data

set -euo pipefail

BOJAN_ROOT="${BOJAN_ROOT:-/opt/bojan}"
readonly ENV_FILE="$BOJAN_ROOT/.env"

if [[ -t 1 ]]; then
  readonly BOLD=$'\033[1m' DIM=$'\033[2m' RED=$'\033[31m' GREEN=$'\033[32m' YELLOW=$'\033[33m' CYAN=$'\033[36m' RESET=$'\033[0m'
else
  readonly BOLD='' DIM='' RED='' GREEN='' YELLOW='' CYAN='' RESET=''
fi

step() { printf '\n%s==>%s %s\n' "$BOLD" "$RESET" "$1"; }
info() { printf '    %s\n' "$1"; }
warn() { printf '    %s%s%s\n' "$YELLOW" "$1" "$RESET"; }
ok()   { printf '    %s%s%s\n' "$GREEN" "$1" "$RESET"; }
die()  { printf '\n%serror:%s %s\n\n' "$RED" "$RESET" "$1" >&2; exit 1; }

[[ -d "$BOJAN_ROOT" ]] || die "No installation at $BOJAN_ROOT. Set BOJAN_ROOT if it lives elsewhere."
[[ -f "$ENV_FILE" ]]   || die "No .env at $ENV_FILE — has deploy/install.sh been run?"
cd "$BOJAN_ROOT"

# Docker needs root or the docker group; find the prefix that works rather than
# forcing the whole tool to be run under sudo.
if [[ "$(id -u)" -eq 0 ]]; then
  SUDO=''
elif docker info >/dev/null 2>&1; then
  SUDO=''
elif command -v sudo >/dev/null 2>&1; then
  SUDO='sudo'
else
  die "Need root or membership of the docker group."
fi

compose() { $SUDO docker compose --env-file "$ENV_FILE" "$@"; }

set_key() {
  local key="$1" value="$2"
  if grep -qE "^${key}=" "$ENV_FILE"; then
    $SUDO sed -i "s|^${key}=.*|${key}=${value}|" "$ENV_FILE"
  else
    printf '%s=%s\n' "$key" "$value" | $SUDO tee -a "$ENV_FILE" >/dev/null
  fi
}

value_of() {
  local value
  value="$(grep -E "^$1=" "$ENV_FILE" 2>/dev/null | head -1 | cut -d= -f2- || true)"
  printf '%s' "${value:-${2:-}}"
}

# Anything the compose file declares that is not running and healthy.
#
# Checked against `compose config --services` rather than against whatever
# containers happen to exist: a service whose image failed to build has no
# container, and a container that does not exist reports no health — so asking
# only "is anything unhealthy?" answers no for a stack that is missing half of
# itself. A service with no healthcheck of its own passes on running alone.
unhealthy_services() {
  local state
  while read -r service; do
    [[ -n "$service" ]] || continue
    state="$(compose ps --format '{{.Service}} {{.State}} {{.Health}}' 2>/dev/null |
      awk -v s="$service" '$1 == s { print $2 " " $3 }')"
    case "$state" in
      '')               printf '%s\n' "$service" ;;
      running\ healthy) ;;
      running\ )        ;;
      *)                printf '%s\n' "$service" ;;
    esac
  done < <(compose config --services 2>/dev/null)
}

wait_healthy() {
  local deadline=$(( SECONDS + ${1:-300} )) pending=''
  while (( SECONDS < deadline )); do
    pending="$(unhealthy_services)"
    [[ -z "$pending" ]] && return 0
    sleep 5
  done
  printf '%s' "$pending"
  return 1
}

# --- commands ---------------------------------------------------------------

cmd_status() {
  step "Services"
  compose ps
  printf '\n'
  printf '  storefront   %s\n' "$(value_of PUBLIC_STOREFRONT_URL)"
  printf '  admin panel  %s\n' "$(value_of PUBLIC_ADMIN_URL "http://localhost:$(value_of ADMIN_PORT 3001)")"
  printf '  operator     admin@bojan.com\n\n'
}

cmd_logs()    { compose logs -f --tail=100 "$@"; }
cmd_restart() { step "Restarting"; compose restart; ok "Done."; }
cmd_stop()    { step "Stopping"; compose down; ok "Stopped. Data volumes kept."; }
cmd_start()   { step "Starting"; compose up -d; ok "Started."; }

cmd_backup() {
  local dir="$BOJAN_ROOT/backups"
  local file="$dir/bojan-$(date +%Y%m%d-%H%M%S).sql.gz"
  $SUDO mkdir -p "$dir"

  step "Dumping the database"
  # Through the running container, so this needs no client tools on the host.
  compose exec -T postgres pg_dump \
    -U "$(value_of POSTGRES_USER bojan)" \
    -d "$(value_of POSTGRES_DB bojan)" | gzip | $SUDO tee "$file" >/dev/null

  ok "Wrote $file ($(du -h "$file" | cut -f1))"
  info "Product media lives in the api-uploads volume and is not in this dump."
}

# Pulls the latest code and rebuilds. If the new images do not come up healthy,
# the previous commit is restored and rebuilt, so a bad release costs a few
# minutes rather than the site.
cmd_update() {
  [[ -d "$BOJAN_ROOT/.git" ]] ||
    die "Not a git checkout — update by replacing $BOJAN_ROOT and re-running deploy/install.sh."

  step "Checking for updates"
  local previous
  previous="$($SUDO git -C "$BOJAN_ROOT" rev-parse HEAD)"
  info "Currently at ${previous:0:8}"

  $SUDO git -C "$BOJAN_ROOT" fetch --depth 1 origin main || die "Could not reach the repository."

  local latest
  latest="$($SUDO git -C "$BOJAN_ROOT" rev-parse origin/main)"
  if [[ "$previous" == "$latest" ]]; then
    ok "Already up to date."
    return 0
  fi
  info "Updating to ${latest:0:8}"

  # Back the database up first: a migration in the new release changes the
  # schema, and that is the step nothing else can undo.
  cmd_backup

  $SUDO git -C "$BOJAN_ROOT" reset --hard origin/main >/dev/null

  step "Rebuilding"
  if compose build && compose up -d --remove-orphans && wait_healthy 420 >/dev/null; then
    ok "Updated to ${latest:0:8}."
    return 0
  fi

  warn "The new release did not come up healthy — rolling back."
  $SUDO git -C "$BOJAN_ROOT" reset --hard "$previous" >/dev/null
  compose build >/dev/null && compose up -d --remove-orphans

  if wait_healthy 420 >/dev/null; then
    warn "Rolled back to ${previous:0:8}; the site is up. Check 'b-ui logs' for why the update failed."
  else
    die "Rollback did not come up healthy either. Inspect with: b-ui logs"
  fi
  return 1
}

cmd_password() {
  step "Operator password"
  info "Sets the password for admin@bojan.com."

  local first second
  read -r -s -p "    New password (at least 12 characters): " first </dev/tty; printf '\n'
  read -r -s -p "    Again: " second </dev/tty; printf '\n'

  [[ "$first" == "$second" ]] || die "They did not match."
  (( ${#first} >= 12 )) || die "Too short — at least 12 characters."

  set_key ADMIN_PASSWORD "$first"

  # The seeder only creates an operator when there is none, so changing the
  # variable alone does not touch an account that already exists. Removing the
  # row lets the next boot recreate it with the new password.
  warn "Resetting the operator account so the new password takes effect."
  compose exec -T postgres psql \
    -U "$(value_of POSTGRES_USER bojan)" \
    -d "$(value_of POSTGRES_DB bojan)" \
    -c 'DELETE FROM admin_users;' >/dev/null

  compose restart api >/dev/null
  if wait_healthy 180 >/dev/null; then
    ok "Password changed. Sign in as admin@bojan.com."
  else
    die "The API did not come back healthy. Check: b-ui logs api"
  fi
}

cmd_domain() {
  step "Public address"
  info "Storefront: $(value_of PUBLIC_STOREFRONT_URL)"
  info "Panel:      $(value_of PUBLIC_ADMIN_URL)"
  printf '\n'

  local domain
  read -r -p "    New domain, without https:// (e.g. bojan.ir): " domain </dev/tty
  [[ -n "$domain" ]] || die "Nothing entered."

  domain="${domain#http://}"; domain="${domain#https://}"; domain="${domain%%/*}"
  [[ "$domain" =~ ^[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]] || die "That does not look like a domain."

  set_key PUBLIC_DOMAIN "$domain"
  set_key PUBLIC_STOREFRONT_URL "https://${domain}"
  set_key PUBLIC_ADMIN_URL "https://admin.${domain}"
  set_key PUBLIC_API_URL "https://${domain}"

  # The vhost names the domain in half a dozen places and the certificate is
  # issued against it, so both are rebuilt rather than edited.
  if [[ -f "$BOJAN_ROOT/deploy/install.sh" ]]; then
    step "Reconfiguring nginx and the certificate"
    $SUDO bash "$BOJAN_ROOT/deploy/install.sh" --web-only || warn "The web step reported a problem."
  fi

  # These values are compiled into the browser bundle at build time, so a
  # rebuild is not optional — restarting would keep serving the old URL.
  warn "Rebuilding: the address is compiled into the browser bundle."
  compose build storefront admin && compose up -d storefront admin

  if wait_healthy 420 >/dev/null; then
    ok "Now serving https://${domain} and https://admin.${domain}"
  else
    die "Services did not come back healthy. Check: b-ui logs"
  fi
}

cmd_ssl() {
  command -v certbot >/dev/null 2>&1 ||
    die "certbot is not installed — this host was set up without a domain. Add one with: b-ui domain"

  local domain; domain="$(value_of PUBLIC_DOMAIN)"
  [[ -n "$domain" ]] || die "No domain configured. Set one with: b-ui domain"

  # `renew` only ever touches certificates that already exist. With none, it
  # prints "No renewals were attempted" and exits zero — so this used to report
  # a certificate that was up to date when there was no certificate at all, on
  # the one screen an operator opens precisely because issuance failed.
  if $SUDO certbot certificates 2>/dev/null | grep -q "Domains:.*\b${domain}\b"; then
    step "Renewing the certificate for $domain"
    # A no-op on a certificate that is not near expiry, which is the right
    # behaviour for a button someone presses when unsure.
    if ! $SUDO certbot renew --nginx --non-interactive; then
      die "certbot could not renew. Run 'certbot certificates' to see what it holds."
    fi
    ok "Certificate up to date."
  else
    step "Issuing a certificate for $domain"
    info "None exists yet — asking for one rather than renewing nothing."

    local email; email="$(value_of TLS_CONTACT_EMAIL)"
    local -a args=(--nginx --non-interactive --agree-tos --redirect
                   -d "$domain" -d "www.${domain}" -d "admin.${domain}")

    if [[ -n "$email" && "$email" =~ ^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$ ]]; then
      args+=(--email "$email")
    else
      [[ -n "$email" ]] && warn "TLS_CONTACT_EMAIL is not an e-mail address — registering without one."
      args+=(--register-unsafely-without-email)
    fi

    if ! $SUDO certbot "${args[@]}"; then
      die "certbot could not issue a certificate — its output above says why.
    The usual cause is DNS: ${domain}, www.${domain} and admin.${domain} must
    all resolve to this host before Let's Encrypt will certify them."
    fi
    ok "Certificate issued; http now redirects to https."
  fi

  $SUDO nginx -t && $SUDO systemctl reload nginx
  ok "nginx reloaded."
}

# --- menu -------------------------------------------------------------------

banner() {
  clear 2>/dev/null || true
  local domain pending
  domain="$(value_of PUBLIC_DOMAIN)"
  pending="$(unhealthy_services)"

  printf '%b\n' "${BOLD}${CYAN}Bojan Store — System Management${RESET}"
  printf '%b\n' "Domain: ${CYAN}${domain:-not set}${RESET}   ${DIM}${BOJAN_ROOT}${RESET}"

  if [[ -z "$pending" ]]; then
    printf '%b\n\n' "Status: ${GREEN}all services healthy${RESET}"
  else
    printf '%b\n\n' "Status: ${YELLOW}not healthy — $(echo "$pending" | tr '\n' ' ')${RESET}"
  fi
}

menu() {
  while true; do
    banner
    echo "  1) Service status and addresses"
    echo "  2) Follow the logs"
    echo "  3) Update to the latest release (rolls back if unhealthy)"
    echo "  4) Change the operator password"
    echo "  5) Domain management (change address, re-issue certificate)"
    echo "  6) Renew the TLS certificate now"
    echo "  7) Back up the database"
    echo "  8) Restart services"
    echo "  9) Stop everything (data kept)"
    echo "  0) Exit"
    echo

    local choice
    read -r -p "  Choose an option: " choice </dev/tty || return 0
    case "$choice" in
      1) cmd_status ;;
      2) printf '    %sCtrl-C to stop following.%s\n' "$DIM" "$RESET"; cmd_logs || true ;;
      3) cmd_update || true ;;
      4) cmd_password || true ;;
      5) cmd_domain || true ;;
      6) cmd_ssl || true ;;
      7) cmd_backup || true ;;
      8) cmd_restart ;;
      9) cmd_stop; return 0 ;;
      0) return 0 ;;
      *) warn "Not an option." ;;
    esac

    echo
    read -r -p "  Press Enter to continue..." _ </dev/tty || return 0
  done
}

case "${1:-}" in
  status)   cmd_status ;;
  logs)     shift; cmd_logs "$@" ;;
  update)   cmd_update ;;
  restart)  cmd_restart ;;
  start)    cmd_start ;;
  stop)     cmd_stop ;;
  backup)   cmd_backup ;;
  password) cmd_password ;;
  domain)   cmd_domain ;;
  ssl)      cmd_ssl ;;
  --help|-h|help)
    awk 'NR>2 { if ($0 !~ /^#/) exit; sub(/^# ?/, ""); print }' "${BASH_SOURCE[0]}" ;;
  '')       menu ;;
  *)        die "Unknown command: $1 (try 'b-ui --help')" ;;
esac
