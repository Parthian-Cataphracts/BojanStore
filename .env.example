# Configuration for docker-compose.yml.
#
# `./install.sh` generates a real .env from this, filling every secret below
# with random bytes. Copy it by hand only if you intend to choose the values
# yourself — and if you do, generate each secret with:
#
#   openssl rand -hex 32
#
# ---------------------------------------------------------------------------
# Public URLs
# ---------------------------------------------------------------------------
# The domain the installer builds the nginx vhost and the TLS certificate
# around. Set it and the storefront answers on the name itself, the panel on
# `admin.`, and certbot covers both plus `www`. Leave it blank and none of that
# is installed: on a plain IP there is nothing to certify, and the ports below
# are reachable over an ssh tunnel. `b-ui domain` changes it afterwards.
PUBLIC_DOMAIN=

# Where Let's Encrypt sends expiry warnings. Optional — certbot registers
# without one — but a certificate that lapses unannounced takes the shop down.
TLS_CONTACT_EMAIL=

# How a *browser* reaches each site. These are compiled into the client bundles
# at image build time, so changing one means rebuilding: `./install.sh --rebuild`.
# The installer fills all three in from PUBLIC_DOMAIN when it is set; edit them
# directly only for a bare test box with no name.
PUBLIC_STOREFRONT_URL=http://localhost:3000
PUBLIC_ADMIN_URL=http://localhost:3001
PUBLIC_API_URL=http://localhost:7001

# ---------------------------------------------------------------------------
# Published ports
# ---------------------------------------------------------------------------
# Bound to 127.0.0.1. nginx forwards to them when a domain is set; otherwise
# nothing outside the host reaches them at all.
# ---------------------------------------------------------------------------
STOREFRONT_PORT=3000
ADMIN_PORT=3001
API_PORT=7001

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Never published outside the compose network, but the password is still a
# real credential: it is what the API authenticates with.
POSTGRES_DB=bojan
POSTGRES_USER=bojan
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Signs customer session tokens the API issues. At least 32 characters.
JWT_SIGNING_KEY=
JWT_ISSUER=bojan-api
JWT_AUDIENCE=bojan-storefront

# How many proxies stand in front of the shop.
#
# Every rate limit in the API buckets on the caller's address, and both Next
# servers forward that address to it — read from the trusted end of
# X-Forwarded-For, because proxies append to that header and its left-most
# entry is whatever the caller sent. One is the single reverse proxy the
# compose file expects; a CDN in front of that proxy is two. Set it wrong and
# the limits either bucket on an address a caller chose, or fall back to
# bucketing the whole shop as one client.
TRUSTED_PROXY_HOPS=1

# Shared secret the two Next servers send as X-Api-Key. It is how the API tells
# a request from its own frontend from a request a browser made directly, which
# is why the customer id those servers assert is trusted at all. Must never be
# exposed to a browser — note it is not a NEXT_PUBLIC_ variable.
API_KEY=

# Sign the two apps' session cookies (HMAC-SHA256), at least 32 characters each.
# Deliberately different values: sharing one would let a customer session be
# replayed as an operator session.
STOREFRONT_AUTH_SECRET=
ADMIN_AUTH_SECRET=

# ---------------------------------------------------------------------------
# Wallet
# ---------------------------------------------------------------------------
# Whether customers may file a card-to-card transfer for an operator to confirm
# and credit. Leave false unless someone is actually reading that queue against
# the bank statement: an unattended queue is either ignored or waved through,
# and the second is how a wallet fills with money nobody sent. Gateway top-ups
# are unaffected — those are settled by the gateway's own verification.
WALLET_MANUAL_TOPUP_ENABLED=false

# ---------------------------------------------------------------------------
# Notification senders
# ---------------------------------------------------------------------------
# SMS is configured in the panel, under تنظیمات ← پیامک: the sms.ir account, the
# service-line template a sign-in code goes out through, and the advertising
# line campaigns use. Nothing about it lives here, because an API key that
# arrives through an environment file ends up in a backup, a shell history and
# eventually a support screenshot. The same is true of the payment gateway's
# merchant id.
#
# Until that account is entered, messages go to the log instead of a phone. This
# setting says whether the log may carry what was in them — which for a sign-in
# code means printing the credential itself, so it is off unless a host says
# otherwise. Off, a dropped code is logged as an error naming only the number.
#
# `true` is for a developer's machine. On a real deployment leave it false: it
# matters who can read the container logs on this host.
ALLOW_CONSOLE_SENDERS=false

# ---------------------------------------------------------------------------
# First-run seeding
# ---------------------------------------------------------------------------
# Fills an empty database with the catalogue and creates the owner account.
# Every table that already has rows is skipped, so this is safe to leave on —
# it does nothing on a deployment that already has data.
SEED_ENABLED=true

# The owner account's password. There is no default: without one, seeding
# creates no operator and nobody can sign in to the panel.
ADMIN_PASSWORD=
