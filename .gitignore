pnpm-debug.log*
yarn-debug.log*

# scratch files from local verification sweeps
*.tmp.txt

# --- local analysis ---
# Generated knowledge graph. Rebuilt on demand; several megabytes of derived
# output that would only ever conflict.
graphify-out/
