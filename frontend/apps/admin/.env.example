# Base URL of the .NET 10 backend admin API.
# Plain http by default — see the storefront's .env.example for why.
API_BASE_URL=http://localhost:7001/api/admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001/api/admin

# Shared secret this server sends to the API as X-Api-Key, proving the request
# came from here rather than from a browser. Must match the API's
# TrustedProxy:ApiKey. Deliberately not NEXT_PUBLIC_ — it must never be bundled
# into client code.
API_KEY=

# While the backend is not up yet the panel reads its fixtures, and writes are
# validated and acknowledged without being forwarded anywhere.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Signs the admin session cookie (HMAC-SHA256). At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Use a *different* value from the storefront's, so a
# customer session can never be replayed as an operator session.
AUTH_SECRET=

# The single operator the panel accepts while NEXT_PUBLIC_USE_MOCK_DATA is on.
# Sign-in is refused until ADMIN_DEV_PASSWORD is set — there is no default
# password that works.
ADMIN_DEV_EMAIL=admin@bojan.com
ADMIN_DEV_PASSWORD=
