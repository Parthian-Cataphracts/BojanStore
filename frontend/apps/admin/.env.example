# Base URL of the .NET 10 backend admin API.
# Plain http by default — see the storefront's .env.example for why.
API_BASE_URL=http://localhost:7001/api/admin
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001/api/admin

# Shared secret this server sends to the API as X-Api-Key, proving the request
# came from here rather than from a browser. Must match the API's
# TrustedProxy:ApiKey. Deliberately not NEXT_PUBLIC_ — it must never be bundled
# into client code.
API_KEY=

# While the backend is not up yet the panel reads its fixtures, and writes are
# validated and acknowledged without being forwarded anywhere.
NEXT_PUBLIC_USE_MOCK_DATA=true

# Signs the admin session cookie (HMAC-SHA256). At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production. Use a *different* value from the storefront's, so a
# customer session can never be replayed as an operator session.
AUTH_SECRET=

# The single operator the panel accepts while NEXT_PUBLIC_USE_MOCK_DATA is on.
# Sign-in is refused until ADMIN_DEV_PASSWORD is set — there is no default
# password that works.
ADMIN_DEV_EMAIL=admin@bojan.com
ADMIN_DEV_PASSWORD=

# The same operator's number, for the one-time-code form on screen 91. That
# form is development-only — the API has no admin OTP endpoint — and it is
# refused until both of these are set, again with no default that works. A
# code is only ever issued for the number below.
ADMIN_DEV_PHONE=
ADMIN_DEV_OTP=

# How many proxies stand in front of this app.
#
# Rate limits bucket on the client address, read from the trusted end of
# X-Forwarded-For — proxies append to that header, so its left-most entry is
# whatever the caller sent and counting from the right is what makes the value
# trustworthy. One is a single reverse proxy, which is what the compose file
# expects; a CDN in front of that proxy is two.
TRUSTED_PROXY_HOPS=1

# Path under public/ to the shop's logo, e.g. /logo.svg. Left unset until there
# is a file to serve: the component falls back to the "بوژان" wordmark and makes
# no request at all. It used to default to /logo.svg with no such file present,
# so every page view fetched a 404 HTML document.
# NEXT_PUBLIC_BRAND_LOGO=/logo.svg
