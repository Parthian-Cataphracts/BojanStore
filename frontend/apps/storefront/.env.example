# Base URL of the .NET 10 backend API.
# Server components call this directly; the browser uses NEXT_PUBLIC_API_BASE_URL.
# Plain http by default — `dotnet run` (the "http" launch profile) serves this
# port with no dev-certificate trust step needed. Switch to https://localhost:7001
# once you've run `dotnet dev-certs https --trust` and started the "https" profile.
API_BASE_URL=http://localhost:7001/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:7001/api

# Shared secret this server sends to the API as X-Api-Key, proving the request
# came from here rather than from a browser. Must match the API's
# TrustedProxy:ApiKey. Deliberately not NEXT_PUBLIC_ — it must never be bundled
# into client code.
API_KEY=

# While the backend is not up yet, pages fall back to the mock catalogue.
# Set to "false" once the API is reachable.
NEXT_PUBLIC_USE_MOCK_DATA=true

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signs the session and OTP cookies (HMAC-SHA256). At least 32 characters.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required in production — the app refuses to sign a session without it. In
# development a fixed fallback is used so `pnpm dev` works out of the box.
AUTH_SECRET=

# Stands in for the SMS gateway while NEXT_PUBLIC_USE_MOCK_DATA is on: the code
# the sign-in screen accepts. It is never sent to the browser — in development
# it is printed to the server console the way a gateway stub would.
MOCK_OTP_CODE=11111

# How many proxies stand in front of this app.
#
# Rate limits bucket on the client address, read from the trusted end of
# X-Forwarded-For — proxies append to that header, so its left-most entry is
# whatever the caller sent and counting from the right is what makes the value
# trustworthy. One is a single reverse proxy, which is what the compose file
# expects; a CDN in front of that proxy is two.
TRUSTED_PROXY_HOPS=1

# Optional. Lets the shop be previewed while "حالت تعمیر و نگهداری" (screen
# 150) is on: visit any page with ?maintenance_bypass=<this value> once to
# get a 12-hour bypass cookie. Unset disables the bypass entirely — the
# maintenance page shows for everyone with no way around it.
MAINTENANCE_BYPASS_SECRET=
